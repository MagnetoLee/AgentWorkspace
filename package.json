{
  "name": "agent-workspace",
  "displayName": "Agent Workspace",
  "description": "Scope AI coding tasks across multiple Git repositories and review the results in VS Code.",
  "version": "0.1.12",
  "publisher": "agentworkspace",
  "repository": { "type": "git", "url": "https://github.com/lizhaoting/AgentWorkspace.git" },
  "bugs": { "url": "https://github.com/lizhaoting/AgentWorkspace/issues" },
  "keywords": ["AI", "Copilot", "Git", "multi-root workspace", "task management"],
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "capabilities": {
    "untrustedWorkspaces": { "supported": true, "description": "Reads Git status and explicitly selected convention files within the workspace. Task data is stored in local Workspace State." }
  },
  "categories": ["Other", "SCM Providers"],
  "icon": "media/logo-128.png",
  "main": "./src/extension.js",
  "activationEvents": ["onStartupFinished", "onView:agentWorkspace.repositories", "onView:agentWorkspace.tasks", "onView:agentWorkspace.presets", "onCommand:agentWorkspace.configureExplorerIcon"],
  "contributes": {
    "iconThemes": [{ "id": "agent-workspace-roots", "label": "Agent Workspace Root Icons", "path": "./media/theme/current.json" }],
    "viewsContainers": {
      "activitybar": [{ "id": "agentWorkspace", "title": "Agent Workspace", "icon": "media/activity.svg" }]
    },
    "views": {
      "agentWorkspace": [
        { "id": "agentWorkspace.repositories", "name": "Repositories" },
        { "id": "agentWorkspace.tasks", "name": "Task Workspace" },
        { "id": "agentWorkspace.presets", "name": "Task Presets" }
      ]
    },
    "commands": [
      { "command": "agentWorkspace.refresh", "title": "Agent Workspace: Refresh" },
      { "command": "agentWorkspace.configureExplorerIcon", "title": "Agent Workspace: Configure Explorer Root Icon", "icon": "$(symbol-color)" },
      { "command": "agentWorkspace.openGuide", "title": "Agent Workspace: Open Guide" },
      { "command": "agentWorkspace.createTask", "title": "Agent Workspace: New Task", "icon": "$(add)" },
      { "command": "agentWorkspace.editTask", "title": "Agent Workspace: Edit Current Task" },
      { "command": "agentWorkspace.executeTask", "title": "Agent Workspace: Execute Current Task", "icon": "$(play)" },
      { "command": "agentWorkspace.openCopilotSessions", "title": "Agent Workspace: Open Copilot Sessions" },
      { "command": "agentWorkspace.showExecutionDetails", "title": "Agent Workspace: View Execution Record" },
      { "command": "agentWorkspace.stopExecutionTracking", "title": "Agent Workspace: Stop Tracking Changes" },
      { "command": "agentWorkspace.openObservedChange", "title": "Agent Workspace: Open Recorded File" },
      { "command": "agentWorkspace.selectTask", "title": "Agent Workspace: Switch Task" },
      { "command": "agentWorkspace.deleteTask", "title": "Agent Workspace: Delete Current Task" },
      { "command": "agentWorkspace.setScope", "title": "Agent Workspace: Set Repository Scope" },
      { "command": "agentWorkspace.addDirectory", "title": "Agent Workspace: Add Scope Directory" },
      { "command": "agentWorkspace.removeDirectory", "title": "Agent Workspace: Remove Scope Directory" },
      { "command": "agentWorkspace.collectConventions", "title": "Agent Workspace: Select Project Instructions" },
      { "command": "agentWorkspace.copyContext", "title": "Agent Workspace: Copy Context", "icon": "$(copy)" },
      { "command": "agentWorkspace.exportJson", "title": "Agent Workspace: Export Task JSON" },
      { "command": "agentWorkspace.savePreset", "title": "Agent Workspace: Save Task Preset", "icon": "$(save)" },
      { "command": "agentWorkspace.applyPreset", "title": "Agent Workspace: Use Task Preset" },
      { "command": "agentWorkspace.applyPresetRoots", "title": "Agent Workspace: Apply Preset to Workspace Roots" },
      { "command": "agentWorkspace.deletePreset", "title": "Agent Workspace: Delete Task Preset" },
      { "command": "agentWorkspace.openFolder", "title": "Agent Workspace: Reveal in Explorer" },
      { "command": "agentWorkspace.openTerminal", "title": "Agent Workspace: Open Terminal in Repository" },
      { "command": "agentWorkspace.openScm", "title": "Agent Workspace: Open Source Control" },
      { "command": "agentWorkspace.openChange", "title": "Agent Workspace: Open Git Diff" },
      { "command": "agentWorkspace.rebaseline", "title": "Agent Workspace: Rebuild Git Baseline" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "agentWorkspace.configureExplorerIcon", "when": "explorerResourceIsRoot", "group": "navigation" }
      ],
      "view/title": [
        { "command": "agentWorkspace.refresh", "when": "view == agentWorkspace.repositories", "group": "navigation" },
        { "command": "agentWorkspace.createTask", "when": "view == agentWorkspace.tasks", "group": "navigation" },
        { "command": "agentWorkspace.executeTask", "when": "view == agentWorkspace.tasks", "group": "navigation@2" },
        { "command": "agentWorkspace.copyContext", "when": "view == agentWorkspace.tasks", "group": "navigation@3" },
        { "command": "agentWorkspace.savePreset", "when": "view == agentWorkspace.presets", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "agentWorkspace.configureExplorerIcon", "when": "viewItem == awRepository", "group": "navigation" },
        { "command": "agentWorkspace.openFolder", "when": "viewItem == awRepository", "group": "inline" },
        { "command": "agentWorkspace.openTerminal", "when": "viewItem == awRepository", "group": "inline@2" },
        { "command": "agentWorkspace.openScm", "when": "viewItem == awRepository", "group": "inline@3" },
        { "command": "agentWorkspace.openChange", "when": "viewItem == awChange", "group": "inline" },
        { "command": "agentWorkspace.applyPreset", "when": "viewItem == awPreset", "group": "inline" },
        { "command": "agentWorkspace.applyPresetRoots", "when": "viewItem == awPreset", "group": "navigation" },
        { "command": "agentWorkspace.deletePreset", "when": "viewItem == awPreset", "group": "inline@2" },
        { "command": "agentWorkspace.removeDirectory", "when": "viewItem == awDirectory", "group": "inline" }
      ]
    }
  },
  "scripts": { "test": "node --test test/*.test.js", "check": "node --check src/extension.js && node --check src/rootIcons.js && node --check src/core.js && node --check src/taskForm.js && node --check src/handoff.js && node --check src/executionHistory.js && npm test", "package": "python3 scripts/package_vsix.py" }
}
